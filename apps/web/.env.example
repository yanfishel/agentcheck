# Production configuration of the web app. The server refuses to start in
# production when any of these is missing or malformed (src/server/env.ts).

# PostgreSQL (the same database the worker uses).
DATABASE_URL=postgres://agentcheck:<password>@postgres:5432/agentcheck

# The only account that becomes admin (it must be verified in Clerk).
ADMIN_EMAIL=

# HMAC key for client IPs (at least 32 characters), e.g. `openssl rand -hex 32`.
IP_HASH_SECRET=

# The public https origin every link is built from; never taken from request headers.
PUBLIC_BASE_URL=https://agentcheck.dev

# Clerk production instance.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
