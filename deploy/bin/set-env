#!/bin/sh
# Writes the Clerk keys sent by the "Sync server secrets" workflow into the
# server's .env. It is the forced command of the CI deploy key, so it is all
# that key can run. Reads NAME=value lines from stdin; only the names below
# are accepted. Every line is checked before anything is written; it prints
# the names it updated and never a value.
# Usage: set-env [ENV_FILE]   (default /srv/agentcheck/.env)
set -eu

ENV_FILE=${1:-/srv/agentcheck/.env}

umask 077
dir=$(dirname "$ENV_FILE")
updates=$(mktemp "$dir/.set-env-updates.XXXXXX")
next=$(mktemp "$dir/.set-env-next.XXXXXX")
trap 'rm -f "$updates" "$next"' EXIT

while IFS= read -r line || [ -n "$line" ]; do
	[ -z "$line" ] && continue
	case $line in
	*=*) name=${line%%=*} ;;
	*)
		echo "rejected: a line without NAME=" >&2
		exit 1
		;;
	esac
	# An exact match: a substring test would let "A B=x" through.
	case $name in
	CLERK_SECRET_KEY | CLERK_WEBHOOK_SIGNING_SECRET | NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY) ;;
	*)
		echo "rejected: $name is not an allowed name" >&2
		exit 1
		;;
	esac
	printf '%s\n' "$line" >>"$updates"
done

# Nothing to set: leave the file untouched.
[ -s "$updates" ] || exit 0

touch "$ENV_FILE"
# FILENAME, not NR == FNR: the updates file is never empty here, but the
# env file may be.
awk '
	FILENAME == ARGV[1] {
		i = index($0, "=")
		key = substr($0, 1, i - 1)
		if (!(key in value)) order[++n] = key
		value[key] = substr($0, i + 1)
		next
	}
	{
		i = index($0, "=")
		key = i ? substr($0, 1, i - 1) : ""
		if (key in value) {
			if (!(key in done)) print key "=" value[key]
			done[key] = 1
		} else print
	}
	END {
		for (j = 1; j <= n; j++) if (!(order[j] in done)) print order[j] "=" value[order[j]]
	}
' "$updates" "$ENV_FILE" >"$next"
chmod 600 "$next"
mv "$next" "$ENV_FILE"

cut -d= -f1 "$updates" | awk '!seen[$0]++ { print "updated " $0 }'
