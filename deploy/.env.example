# /srv/agentcheck/.env on the server, mode 600. No value lives in the repository.

# The released image tag to run, e.g. v0.1.0 (never "latest"). Written by
# deploy/bin/deploy on every deploy.
AGENTCHECK_VERSION=

# Generated on the server with `openssl rand -hex 32`, never printed.
POSTGRES_PASSWORD=
IP_HASH_SECRET=
# postgres://agentcheck:<POSTGRES_PASSWORD>@postgres:5432/agentcheck
DATABASE_URL=

PUBLIC_BASE_URL=https://agentcheck.dev
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
AUDIT_CONCURRENCY=2

# The only account that becomes admin (verified in Clerk). Written by hand on
# the server; never in the repository.
ADMIN_EMAIL=

# Written only by the "Sync server secrets" workflow (deploy/bin/set-env).
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
